# PORT: Puerto donde corre el servidor web y el bot (por defecto 3000 en local y AI Studio)
PORT=3000

# GEMINI_API_KEY: Opcional en local (el bot en español y escáner regex funcionan sin ella),
# recomendada para lectura de fotos de Pago Móvil con IA y respuestas conversacionales avanzadas.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: URL pública donde está alojada la aplicación (opcional en local: http://localhost:3000)
APP_URL="http://localhost:3000"

